# ブラウザから使う（NEXT_PUBLIC_ 必須）
NEXT_PUBLIC_KEYCLOAK_LOGIN_URL=http://localhost:8081/oauth2/authorization/keycloak

# サーバーサイドの fetch から使う（接頭辞不要）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
# WebSocketだけ別URLにする場合は明示する
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws

API_BASE_URL=http://localhost:8081

NEXT_PUBLIC_URL=http://localhost:3000
